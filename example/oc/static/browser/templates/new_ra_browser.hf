#id main
#url value=ra/{id}


#id author_meta
#endpoint https://sparql.opencitations.net/meta
#method post
#preprocess strip(id)
#postprocess post_author_meta()
#sparql PREFIX datacite: <http://purl.org/spar/datacite/>
PREFIX literal: <http://www.essepuntato.it/2010/06/literalreification/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX schema: <http://schema.org/>

SELECT
    ?orcid
    ?gname
    ?fname
    ?fullname
    (GROUP_CONCAT(?formattedOtherID; separator=" | ") AS ?otherIDs)
WHERE {
  BIND(IRI(CONCAT("https://w3id.org/oc/meta/ra/", "[[id]]")) AS ?res)

  OPTIONAL {
    ?res datacite:hasIdentifier ?id_orcid .
    ?id_orcid datacite:usesIdentifierScheme <http://purl.org/spar/datacite/orcid> ;
               literal:hasLiteralValue ?orcid .
  }

  OPTIONAL {
    ?res datacite:hasIdentifier ?id_other .
    ?id_other datacite:usesIdentifierScheme ?scheme ;
              literal:hasLiteralValue ?value .

    FILTER(?scheme != <http://purl.org/spar/datacite/orcid>)
    
    BIND(STRAFTER(STR(?scheme), "http://purl.org/spar/datacite/") AS ?schemeLabel)

    BIND(CONCAT(?schemeLabel, ":", STR(?value)) AS ?formattedOtherID)
  }

  
  OPTIONAL { ?res foaf:givenName  ?gname . }
  OPTIONAL { ?res foaf:familyName ?fname . }
  OPTIONAL { ?res foaf:name       ?fullname . }

 
}
GROUP BY ?orcid ?gname ?fname ?fullname


#id author_works
#endpoint https://sparql.opencitations.net/meta
#method post
#preprocess strip(id)
#postprocess post_author_works(article, title, pubdate, venue, identifiers, pubList, count, pubYears) 
#sparql PREFIX datacite: <http://purl.org/spar/datacite/>
PREFIX pro: <http://purl.org/spar/pro/>
PREFIX fabio: <http://purl.org/spar/fabio/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX literal: <http://www.essepuntato.it/2010/06/literalreification/>
PREFIX prism: <http://prismstandard.org/namespaces/basic/2.0/>

SELECT DISTINCT 
    ?article 
    ?title 
    ?pubdate 

    
    (GROUP_CONCAT(DISTINCT ?id; separator=" | ") AS ?identifiers)
WHERE {
    
    ?article pro:isDocumentContextFor ?role .
    ?role pro:withRole pro:author ;
          pro:isHeldBy <https://w3id.org/oc/meta/ra/[[id]]> .
    
    
    OPTIONAL { ?article dcterms:title ?title . }
    
    
    OPTIONAL {
        ?article datacite:hasIdentifier ?idnode .
        ?idnode datacite:usesIdentifierScheme ?scheme ;
                literal:hasLiteralValue ?literalValue .
       
        BIND(STRAFTER(STR(?scheme), "http://purl.org/spar/datacite/") AS ?schemePrefix)
        
        BIND(CONCAT(?schemePrefix, ":", ?literalValue) AS ?id)
    }
    
   
    OPTIONAL { ?article prism:publicationDate ?pubdate . }
    
   
}
GROUP BY ?article ?title ?pubdate 
ORDER BY DESC(?pubdate)
LIMIT 1000


