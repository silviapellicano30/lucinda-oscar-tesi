#id main
#url value=br/{omid_digit}

#id doc_meta
#api https://api.opencitations.net/skg-if/v1/products/https://w3id.org/oc/meta/br/[[omid_digit]]
#postprocess post_skgif_document(omid_digit)

#id doc_refs
#api https://api.opencitations.net/skg-if/v1/products?filter=cf.cited_by:https%3A%2F%2Fw3id.org%2Foc%2Fmeta%2Fbr%2F[[omid_digit]]&page=1&page_size=1
#postprocess post_skgif_total()

#id doc_refs_page
#api https://api.opencitations.net/skg-if/v1/products?filter=cf.cited_by:https%3A%2F%2Fw3id.org%2Foc%2Fmeta%2Fbr%2F[[omid_digit]]&page=1&page_size=10

#id doc_cits
#api https://api.opencitations.net/skg-if/v1/products?filter=cf.cites:https%3A%2F%2Fw3id.org%2Foc%2Fmeta%2Fbr%2F[[omid_digit]]&page=1&page_size=1
#postprocess post_skgif_total()

#id doc_cits_page
#api https://api.opencitations.net/skg-if/v1/products?filter=cf.cites:https%3A%2F%2Fw3id.org%2Foc%2Fmeta%2Fbr%2F[[omid_digit]]&page=1&page_size=10

#id document_record
#callfun api_document_record_skgif()
