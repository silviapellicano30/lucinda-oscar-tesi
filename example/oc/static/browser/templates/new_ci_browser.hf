#id main
#url value=ci/{oci}


#id meta2
#endpoint https://sparql.opencitations.net/meta
#method post
#preprocess pre_oci(oci)
#postprocess post_ocmeta_call_2(resource_role, br_id, title, pub_date, authors, ids_list)
#sparql PREFIX datacite:<http://purl.org/spar/datacite/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX pro: <http://purl.org/spar/pro/>
PREFIX prism: <http://prismstandard.org/namespaces/basic/2.0/>
PREFIX dcterm: <http://purl.org/dc/terms/>
PREFIX literal: <http://www.essepuntato.it/2010/06/literalreification/>

SELECT DISTINCT
    ?resource_role
    ?br_id
    (SAMPLE(?title_combined) AS ?title)
    (SAMPLE(?raw_pub_date) AS ?pub_date)
    (GROUP_CONCAT(DISTINCT ?author_name; SEPARATOR="|") AS ?authors)
    (GROUP_CONCAT(DISTINCT ?id; SEPARATOR="|") AS ?ids_list)
WHERE {
    {
        BIND(IRI(CONCAT("https://w3id.org/oc/meta/br/[[citing_br]]")) AS ?res)
        BIND("[[citing_br]]" AS ?br_id)
        BIND("citing" AS ?resource_role)
    }
    UNION
    {
        BIND(IRI(CONCAT("https://w3id.org/oc/meta/br/[[cited_br]]")) AS ?res)
        BIND("[[cited_br]]" AS ?br_id)
        BIND("cited" AS ?resource_role)
    }

    OPTIONAL { ?res datacite:hasTitle ?title_datacite . }
    OPTIONAL { ?res dcterm:title ?title_dcterm . }
    BIND(COALESCE(?title_datacite, ?title_dcterm) AS ?title_combined)

    OPTIONAL { ?res prism:publicationDate ?raw_pub_date . }

    OPTIONAL {
        ?res pro:isDocumentContextFor ?ar .
        ?ar pro:withRole pro:author ;
            pro:isHeldBy ?ra .
        
        OPTIONAL { ?ra foaf:familyName ?familyName . }
        OPTIONAL { ?ra foaf:givenName ?givenName . }
        OPTIONAL { ?ra foaf:name ?name . }

        OPTIONAL { 
             ?ra datacite:hasIdentifier ?authorIdentifier .
             ?authorIdentifier datacite:usesIdentifierScheme datacite:orcid ;
                               literal:hasLiteralValue ?authorIdLiteralValue .
             BIND(CONCAT("orcid:", ?authorIdLiteralValue) AS ?author_orcid)
        }

        
        BIND(
            IF(BOUND(?familyName) && BOUND(?givenName),
               CONCAT(?familyName, ", ", ?givenName),
               COALESCE(?familyName, ?name, "Unknown Author")
            ) AS ?name_text
        )

        
        BIND(
            IF(BOUND(?author_orcid),
                CONCAT(?name_text, " [", STR(?ra), " ", ?author_orcid, "]"),
                CONCAT(?name_text, " [", STR(?ra), "]")
            )
        AS ?author_name)
    }

    OPTIONAL {
        ?res datacite:hasIdentifier ?allIdentifiers .
        ?allIdentifiers datacite:usesIdentifierScheme ?allSchemes ;
                        literal:hasLiteralValue ?allLiteralValues .
        BIND(CONCAT(STRAFTER(STR(?allSchemes), "http://purl.org/spar/datacite/"), ":", ?allLiteralValues) AS ?id)
    }
}
GROUP BY ?resource_role ?br_id
ORDER BY ?resource_role



#id index2
#endpoint https://sparql.opencitations.net/index
#method get
#preprocess pre_oci(oci)
#postprocess post_ocindex_call_2(source_role, references_list, citations_list)
#sparql PREFIX cito: <http://purl.org/spar/cito/>
PREFIX meta: <https://w3id.org/oc/meta/br/>

SELECT 
    ?source_role 
    (GROUP_CONCAT(DISTINCT ?reference_id ; SEPARATOR="|") AS ?references_list)
    (GROUP_CONCAT(DISTINCT ?citation_id ; SEPARATOR="|") AS ?citations_list)
WHERE {
    
    {
        BIND("citing" AS ?source_role)
        
        {
            ?citation cito:hasCitingEntity meta:[[citing_br]] .
            ?citation cito:hasCitedEntity ?related_uri .
            BIND(REPLACE(STR(?related_uri), "https://w3id.org/oc/meta/br/", "") AS ?reference_id)
        }
        UNION
        
        {
            ?citation cito:hasCitedEntity meta:[[citing_br]] .
            ?citation cito:hasCitingEntity ?related_uri .
            BIND(REPLACE(STR(?related_uri), "https://w3id.org/oc/meta/br/", "") AS ?citation_id)
        }
    }
    
    UNION

    
    {
        BIND("cited" AS ?source_role)
        
        {
            ?citation cito:hasCitingEntity meta:[[cited_br]] .
            ?citation cito:hasCitedEntity ?related_uri .
            BIND(REPLACE(STR(?related_uri), "https://w3id.org/oc/meta/br/", "") AS ?reference_id)
        }
        UNION
       
        {
            ?citation cito:hasCitedEntity meta:[[cited_br]] .
            ?citation cito:hasCitingEntity ?related_uri .
            BIND(REPLACE(STR(?related_uri), "https://w3id.org/oc/meta/br/", "") AS ?citation_id)
        }
    }
}
GROUP BY ?source_role