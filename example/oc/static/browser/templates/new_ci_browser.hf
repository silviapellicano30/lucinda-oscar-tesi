#id main
#url value=ci/{oci}

#id citing_meta
#api [[skgif_api]]/products/[[id_base]]br/[[citing]]
#preprocess pre_skgif_oci(oci)
#postprocess post_skgif_ci_doc(citing)

#id cited_meta
#api [[skgif_api]]/products/[[id_base]]br/[[cited]]
#preprocess pre_skgif_oci(oci)
#postprocess post_skgif_ci_doc(cited)

#id citing_refs
#api [[skgif_api]]/products?filter=cf.cited_by:[[id_base_enc]]br%2F[[citing]]&page_size=1
#preprocess pre_skgif_oci(oci)
#postprocess post_skgif_total()

#id citing_cits
#api [[skgif_api]]/products?filter=cf.cites:[[id_base_enc]]br%2F[[citing]]&page_size=1
#preprocess pre_skgif_oci(oci)
#postprocess post_skgif_total()

#id cited_refs
#api [[skgif_api]]/products?filter=cf.cited_by:[[id_base_enc]]br%2F[[cited]]&page_size=1
#preprocess pre_skgif_oci(oci)
#postprocess post_skgif_total()

#id cited_cits
#api [[skgif_api]]/products?filter=cf.cites:[[id_base_enc]]br%2F[[cited]]&page_size=1
#preprocess pre_skgif_oci(oci)
#postprocess post_skgif_total()

#id cited_by_both
#api [[skgif_api]]/products?filter=cf.cited_by:[[id_base_enc]]br%2F[[citing]],cf.cited_by:[[id_base_enc]]br%2F[[cited]]&page_size=1
#preprocess pre_skgif_oci(oci)
#postprocess post_skgif_total()

#id citing_both
#api [[skgif_api]]/products?filter=cf.cites:[[id_base_enc]]br%2F[[citing]],cf.cites:[[id_base_enc]]br%2F[[cited]]&page_size=1
#preprocess pre_skgif_oci(oci)
#postprocess post_skgif_total()

#id ci_record
#callfun api_citation_record_skgif()
