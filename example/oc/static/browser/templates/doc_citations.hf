#id main
#url value=doc_cit/br/{id}

#id doc_meta
#api [[skgif_api]]/products/[[id_base]]br/[[id]]
#postprocess post_skgif_document(id)

#id list_count
#api [[skgif_api]]/products?filter=cf.cites:[[id_base_enc]]br%2F[[id]]&page=1&page_size=1
#postprocess post_skgif_total()

#id list_page
#api [[skgif_api]]/products?filter=cf.cites:[[id_base_enc]]br%2F[[id]]&page=1&page_size=10

#id citations_list
#callfun api_doc_citations_skgif()
