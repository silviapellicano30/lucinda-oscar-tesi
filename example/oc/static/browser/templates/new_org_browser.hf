#id main
#url value=ra/{id}

#id org_meta
#api [[skgif_api]]/organisations/[[id_base]]ra/[[id]]
#postprocess post_skgif_org(id)

#id org_works
#api [[skgif_api]]/products?filter=contributions.by.local_identifier:[[id_base_enc]]ra%2F[[id]]&page=1&page_size=1
#postprocess post_skgif_total()

#id org_works_page
#api [[skgif_api]]/products?filter=contributions.by.local_identifier:[[id_base_enc]]ra%2F[[id]]&page=1&page_size=10

#id org_record
#callfun api_org_record_skgif()
